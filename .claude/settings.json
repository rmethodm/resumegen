{
  "permissions": {
    "allow": [
      "Bash(php artisan test *)",
      "Bash(php artisan route:list *)",
      "mcp__dual-graph__graph_read",
      "mcp__dual-graph__graph_continue",
      "Bash(vendor/bin/phpunit *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-migrate-rollback.sh\""
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/nudge-project-skills.sh\""
          }
        ]
      }
    ]
  }
}
