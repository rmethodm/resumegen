APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://resumegen.test
# Support admin host (domain-scoped routes). Local Herd:
#   herd link admin.resumegen  →  admin.resumegen.test
# Production example: admin.yourdomain.com (must match DNS + TLS).
APP_ADMIN_DOMAIN=admin.resumegen.test
# Destructive admin DB actions (truncate, non-SELECT SQL, schema/role edits).
# Keep false in production; flip true only while you intentionally need them.
ADMIN_DESTRUCTIVE_TOOLS=false
# Idle timeout (minutes) for authenticated sessions on the admin host only.
ADMIN_SESSION_LIFETIME=60

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Production: LOG_STACK=daily (single never rotates — an unbounded file) and
# LOG_LEVEL=warning (debug is noisy and can leak request detail into logs).
# LOG_STACK=daily
# LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=
# Defaults to "prefer" (falls back to plaintext if TLS isn't available) — set
# to "require" in production so a misconfigured managed Postgres never
# silently downgrades to an unencrypted connection.
# DB_SSLMODE=require
# Spatie laravel-backup / db-dumper: directory that contains pg_dump (not the binary name).
# Local Herd: /Users/Shared/Herd/services/postgresql/18/bin
# Leave empty when pg_dump is already on PATH (typical on production).
# DB_DUMP_BINARY_PATH=
# DB_DUMP_TIMEOUT=300

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Unset (falsy) locally so cookies work over plain HTTP. Set to true in
# production — https is required there anyway (secure cookies) — or the
# session cookie can be sent back over an unencrypted connection.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local default: a fake SMTP catcher (e.g. Mailpit) on 127.0.0.1:2525 — no
# mail actually leaves the machine. Registration requires email verification
# (see MustVerifyEmail), so production MUST set a real mailer or nobody can
# log in. This app ships resend/resend-laravel — set MAIL_MAILER=resend and
# RESEND_API_KEY below, or swap in another real provider.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Spatie laravel-backup notification recipient (defaults to MAIL_FROM_ADDRESS).
# BACKUP_NOTIFICATION_EMAIL=
# Optional zip encryption password for Spatie backups (omit to leave archives unencrypted).
# BACKUP_ARCHIVE_PASSWORD=
# RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
